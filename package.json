{
  "name": "sbms-api",
  "version": "1.0.0",
  "description": "ServiceBook Management System API",
  "main": "dist/index.js",
  "scripts": {
    "start": "ts-node src/index.ts",
    "dev": "nodemon --exec ts-node src/index.ts",
    "build": "tsc",
    "start:prod": "node ./dist/index.js",
    "migration:run": "npm run build && typeorm migration:run -d dist/configurations/db.config.js",
    "migration:revert": "npm run build && typeorm migration:revert -d dist/configurations/db.config.js",
    "clean": "rimraf dist",
    "lint": "eslint src --ext ts",
    "lint:fix": "eslint ./src/**/*.ts  --fix",
    "prettier": "prettier --write \"**/*.ts\"",
    "test": "jest --detectOpenHandles",
    "test:coverage": "jest --coverage"
  },
  "author": "",
  "license": "ISC",
  "dependencies": {
    "@types/express": "^5.0.6",
    "@types/express-session": "^1.18.2",
    "@types/multer": "^2.0.0",
    "@types/node-cron": "^3.0.11",
    "bcrypt": "^6.0.0",
    "chai": "^6.2.2",
    "cloudinary": "^2.9.0",
    "cors": "^2.8.6",
    "dotenv": "^17.3.1",
    "exceljs": "^4.4.0",
    "express": "^5.2.1",
    "express-basic-auth": "^1.2.1",
    "express-rate-limit": "^8.2.1",
    "express-session": "^1.19.0",
    "express-validator": "^7.0.1",
    "firebase-admin": "^13.7.0",
    "helmet": "^8.1.0",
    "jest": "^30.2.0",
    "jwt-simple": "^0.5.6",
    "mocha": "^11.7.5",
    "moment": "^2.30.1",
    "moment-timezone": "^0.6.0",
    "morgan": "^1.10.0",
    "multer": "^2.0.2",
    "node-cron": "^4.2.1",
    "nodemailer": "^8.0.1",
    "passport": "^0.7.0",
    "passport-jwt": "^4.0.1",
    "pdfkit": "^0.17.2",
    "pg": "^8.23.1",
    "pm2": "^6.0.14",
    "reflect-metadata": "^0.2.2",
    "streamifier": "^0.1.1",
    "supertest": "^7.2.2",
    "swagger-ui-express": "^5.0.1",
    "tsx": "^4.21.0",
    "typeorm": "^0.3.28",
    "typescript": "^5.9.3",
    "uuid": "^13.0.0",
    "winston": "^3.19.0",
    "winston-daily-rotate-file": "^5.0.0"
  },
  "devDependencies": {
    "@eslint/eslintrc": "^3.3.3",
    "@eslint/js": "^10.0.1",
    "@types/bcrypt": "^6.0.0",
    "@types/cors": "^2.8.19",
    "@types/jest": "^30.0.0",
    "@types/mocha": "^10.0.10",
    "@types/morgan": "^1.9.10",
    "@types/node": "^25.3.0",
    "@types/nodemailer": "^7.0.11",
    "@types/pdfkit": "^0.17.5",
    "@types/streamifier": "^0.1.2",
    "@types/swagger-ui-express": "^4.1.8",
    "@typescript-eslint/eslint-plugin": "^8.56.0",
    "@typescript-eslint/parser": "^8.56.0",
    "eslint": "^10.0.0",
    "eslint-config-standard": "^17.1.0",
    "globals": "^17.3.0",
    "prettier": "^3.8.1",
    "ts-jest": "^29.4.6"
  }
