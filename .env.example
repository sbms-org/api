# API Configuration
API_BASE=/api/v1
PORT=3000
NODE_ENV=development

# Active database configuration (legacy shared API and current SBMS MVP: MySQL).
# The SBMS specification calls for PostgreSQL/PostGIS; that full shared-schema
# migration is pending. Do not set PostgreSQL here until legacy entities and
# migrations have been converted too.
MYSQL_HOST=localhost
MYSQL_PORT=3306
MYSQL_USER=root
MYSQL_PASS=your_password
MYSQL_DB=pms_db

# JWT
JWT_SECRET=your_jwt_secret_key_here

# Firebase Cloud Messaging (Push Notifications)
FIREBASE_SERVICE_ACCOUNT_PATH=/path/to/firebase-serviceAccountKey.json

# Email (SMTP) Configuration
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your-email@gmail.com
SMTP_PASS=your-app-password
SMTP_FROM=noreply@pms.com

# Cloudinary (File Upload)
CLOUDINARY_CLOUD_NAME=your_cloud_name
CLOUDINARY_API_KEY=your_api_key
CLOUDINARY_API_SECRET=your_api_secret

# SMS Service (Optional)
SMS_API_KEY=your_sms_api_key
SMS_SENDER_ID=your_sender_id

# Development Secret (for testing)
DEV_SECRET=dev_test_secret_123
